# Core Django Configs
DJANGO_SECRET_KEY=replace-with-a-strong-random-django-secret-key
DJANGO_DEBUG=True
SECURE_SSL_REDIRECT=False
ALLOWED_HOSTS=localhost,127.0.0.1,web

# PostgreSQL Settings
DB_NAME=scraper_db
DB_USER=postgres
DB_PASSWORD=replace-with-a-strong-password
DB_HOST=db
DB_PORT=5432

# Cache & Redis Broker
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/1

# Frontend / CORS / CSRF Settings
VITE_API_BASE_URL=http://scraper.local/api
VITE_WS_BASE_URL=ws://scraper.local
CORS_ALLOWED_ORIGINS=http://localhost,http://127.0.0.1,http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost,http://127.0.0.1,http://localhost:5173,http://127.0.0.1:5173
